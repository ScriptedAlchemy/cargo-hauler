{
  "name": "cargo-hauler",
  "version": "0.9.11",
  "license": "MIT",
  "private": false,
  "description": "Orchestrate cargo across Claude, Codex, and Cursor so concurrent agent sessions share work instead of fighting locks.",
  "keywords": [
    "cargo",
    "rust",
    "agent",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "build-orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScriptedAlchemy/cargo-hauler.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "cargo-hauler": "./dist/bin/cargo-hauler.mjs",
    "cargo-hauler-install": "./dist/bin/cargo-hauler-install.js",
    "hauler": "./dist/bin/hauler.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "agent-bundle build",
    "check": "pnpm check:artifact && pnpm validate && pnpm build && pnpm typecheck && pnpm diagnostics && pnpm test && pnpm test:routes && pnpm test:browser && pnpm validate:artifact",
    "check:artifact": "node --test tests/packaging/committed-artifact.test.mjs && pnpm validate:artifact",
    "changeset": "changeset",
    "dev": "agent-bundle dev",
    "diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "doctor": "agent-bundle doctor",
    "inspect": "agent-bundle inspect",
    "prepack": "agent-bundle prepack",
    "test": "rstest",
    "test:browser": "rstest --config rstest.browser-app.config.ts",
    "test:routes": "rstest --config rstest.route-unit.config.ts",
    "typecheck": "pnpm validate && tsc -p tsconfig.json --noEmit",
    "validate": "agent-bundle validate",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "release:publish": "pnpm run build && changeset publish",
    "release:version": "changeset version && pnpm build && pnpm validate:artifact",
    "validate:artifact": "agent-bundle validate --artifact artifact"
  },
  "devDependencies": {
    "@agent-bundle/runtime": "https://pkg.pr.new/ScriptedAlchemy/agent-bundle/@agent-bundle/runtime@1a7705899f4e5fc8382524d6d7869aa8e5884a21",
    "@changesets/cli": "3.0.3",
    "@effect/atom-react": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/tsgo": "0.45.0",
    "@rstest/browser": "0.12.1",
    "@rstest/core": "0.12.1",
    "@types/node": "^22.18.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "agent-bundle": "https://pkg.pr.new/ScriptedAlchemy/agent-bundle/agent-bundle@1a7705899f4e5fc8382524d6d7869aa8e5884a21",
    "bashjsast": "github:woolkingx/bashjsast#131f4b677d1906774fc49cfceab0ccb7b370b2e6",
    "effect": "4.0.0-rc.117",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e",
    "proper-lockfile": "^4.1.2",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "scheduler": "^0.28.0",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "packageManager": "pnpm@12.6.0"
}
